<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- USB sync (spec, "USB sync with the phone", step 1): the Companion
	     reads the app's Documents folder, so iOS file sharing is on. -->
	<key>UIFileSharingEnabled</key>
	<true/>
	<key>LSSupportsOpeningDocumentsInPlace</key>
	<true/>
	<key>NSCameraUsageDescription</key>
	<string>Disc-over uses the camera to scan barcodes and photograph your copies.</string>
</dict>
</plist>
